<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0;net9.0-windows10.0.19041.0;net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sundew.Xaml.Controls</RootNamespace>
    <Description>Various WinUI and Uno Platform controls:
- Border - A border supporting individual brushes for each side.
- FullWindow - A Window with no border or title bar, so that the caption and its buttons can be drawn as content.
- Overlays.OverlayWindow - A click through overlay window. (WinUI only)
- Overlays.SubtitleOverlay - An overlay window for displaying subtitles. (WinUI only)
    </Description>
  </PropertyGroup>

  <!--
    The Windows target is WinUI 3 proper, which draws with Win2D and also serves the Windows head of an Uno app.
    Every other Uno target draws with Skia. Both run the very same Border, over the IBorderSurface abstraction.
  -->
  <PropertyGroup>
    <IsWin2DTarget>false</IsWin2DTarget>
    <IsWin2DTarget Condition="$(TargetFramework.Contains('-windows'))">true</IsWin2DTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsWin2DTarget)' == 'true'">
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <!-- A library is built AnyCPU on purpose; the consuming app picks the platform Win2D needs. -->
    <Win2DWarnNoPlatform>false</Win2DWarnNoPlatform>
    <!-- The XAML markup compiler runs an intermediate compile without a PDB, which source embedding forbids. -->
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <!-- SUNDEW_WINUI says WinUI 3 proper rather than Uno, which is the same target said for a different reason. -->
    <DefineConstants>$(DefineConstants);SUNDEW_WIN2D;SUNDEW_WINUI;SUNDEW_CREATE_FROM_STRING</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsWin2DTarget)' != 'true'">
    <DefineConstants>$(DefineConstants);SUNDEW_SKIA;SUNDEW_CREATE_FROM_STRING</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsWin2DTarget)' == 'true'">
    <!-- Same reason as the property above: the intermediate compile emits no PDB, so nothing may be embedded. -->
    <EmbeddedFiles Remove="@(EmbeddedFiles)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sundew.Xaml.Controls.Primitives\Sundew.Xaml.Controls.Primitives.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Backends\**\*.cs" />
  </ItemGroup>

  <!--
    An overlay is a window of our own making, drawn into as a XAML island and placed with Win32, which is WinUI 3
    only. Its control theme goes with it, because the theme names types that only that target compiles. The
    full window is not: it is the framework's own window told what the window manager is to leave off, and
    every Uno target has the Microsoft.UI.Windowing and Microsoft.UI.Input that says it.
  -->
  <ItemGroup>
    <Compile Remove="Overlays\**\*.cs" />
    <!--
      Running the backdrop controller rather than naming a backdrop is WinUI 3 only. Uno has the types but none of
      what they do, so a full window there is left with the backdrop the framework hands out.
    -->
    <Compile Remove="AlwaysDrawnBackdrop.cs" />
  </ItemGroup>

  <!--
    What a full window can be told to do is the same wherever it is drawn, so the commands its caption
    binds its buttons to are shared as source too.
  -->
  <ItemGroup>
    <Compile Include="..\Shared\Windows\*.cs" LinkBase="Shared\Windows" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsWin2DTarget)' != 'true'">
    <Page Remove="Themes\**\*.xaml" />
    <None Remove="Themes\**\*.xaml" />
    <UpToDateCheckInput Remove="Themes\**\*.xaml" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsWin2DTarget)' == 'true'">
    <Compile Include="Backends\Win2D\**\*.cs" />
    <Compile Include="Overlays\**\*.cs" />
    <Compile Include="AlwaysDrawnBackdrop.cs" />
    <!--
      The window manager calls behind a click through overlay are the same whichever framework draws into the
      window, so each platform library compiles its own copy from one source, the way the XAML surface types are
      shared.
    -->
    <Compile Include="..\Shared\Overlays\*.cs" LinkBase="Shared\Overlays" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsWin2DTarget)' != 'true'">
    <Compile Include="Backends\Skia\**\*.cs" />
    <Compile Include="..\Shared\Skia\*.cs" LinkBase="Shared\Skia" />
    <PackageReference Include="Uno.WinUI" />
    <PackageReference Include="Uno.WinUI.Graphics2DSK" />
  </ItemGroup>

  <!--
    Stops and CornerStops are the XAML surface rather than geometry, so each platform library compiles its own copy
    from one source. Sharing them as an assembly instead would put the same type name in two assemblies of the same
    reference graph, which the WinUI and Uno XAML compilers cannot resolve.
  -->
  <ItemGroup>
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <!--
    The renderer and everything it paints with know nothing of XAML or of any one graphics library, so they are
    shared as source with the MAUI library rather than kept here. Only BrushResolver, which turns the brushes of
    this framework into them, stays behind.
  -->
  <ItemGroup>
    <Compile Include="..\Shared\Rendering\*.cs" LinkBase="Shared\Rendering" />
  </ItemGroup>

</Project>
