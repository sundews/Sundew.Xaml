<Project Sdk="Uno.Sdk">

  <PropertyGroup>
    <!--
      All four heads by default. The mobile and WebAssembly ones need the android, ios and wasm-tools workloads,
      which a plain build agent does not have, so CI sets SundewUnoAllHeads=false and builds the desktop head alone.
    -->
    <SundewUnoAllHeads Condition="'$(SundewUnoAllHeads)' == ''">true</SundewUnoAllHeads>
    <TargetFrameworks Condition="'$(SundewUnoAndroidOnly)' != 'true'">net10.0-desktop</TargetFrameworks>
    <TargetFrameworks Condition="'$(SundewUnoAllHeads)' == 'true' And '$(SundewUnoAndroidOnly)' != 'true'">net10.0-desktop;net10.0-android;net10.0-ios;net10.0-browserwasm</TargetFrameworks>
    <!--
      Publishing the Android head compiled ahead of time needs this to be a single target framework project.
      A project with the plural is cross targeting, and publish then dispatches to an inner build; the NativeAOT
      hooks do not survive that dispatch, so the native link never runs and the apk comes out without the native
      library in it. The publish is run with no restore, so naming one framework here does not disturb what was
      restored for the other heads.
    -->
    <TargetFramework Condition="'$(SundewUnoAndroidOnly)' == 'true'">net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Sundew.Xaml.Uno.Development.Tester</RootNamespace>
    <UnoSingleProject>true</UnoSingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <ApplicationTitle>Sundew.Xaml Uno Tester</ApplicationTitle>
    <ApplicationId>dev.sundew.xaml.unotester</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>Sundews</ApplicationPublisher>
    <Description>Development tester for the Sundew.Xaml border on Uno Platform.</Description>

    <!-- The Skia renderer is what SKCanvasElement, and so the Skia border surface, draws into. -->
    <UnoFeatures>
      SkiaRenderer;
    </UnoFeatures>

    <!-- The repository embeds untracked sources, which the heads here build without a PDB for. -->
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-desktop'">
    <!-- NativeAOT, which this head supports and the Android, iOS and browser heads do not. It is set here rather
         than passed on the command line: a command line property reaches every referenced project, and the
         netstandard2.0 primitives library cannot be compiled ahead of time at all. -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedFiles Remove="@(EmbeddedFiles)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sundew.Xaml.Controls.WinUI\Sundew.Xaml.Controls.WinUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The startup clock, shared so that every tester measures the same span the same way. -->
    <Compile Include="..\Shared\Development\StartupClock.cs" LinkBase="Shared\Development" />
  </ItemGroup>


  <!--
    NativeAOT for Android, which .NET 10 supports through a runtime pack of its own. It is deliberately not on by
    default: with PublishAot set, an ordinary build runs the trimmer and the native compiler too, because an
    Android app carries its code as a native library inside the apk. The launcher asks for it when it publishes.
  -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-android')) And '$(SundewAndroidAot)' == 'true'">
    <PublishAot>true</PublishAot>
    <!-- Mono.Android and Java.Interop report AOT analysis warnings of their own, which are not ours to fix. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!--
      Hot Design is a design time tool and brings tooling assemblies along with it that carry no runtime
      identifier, which the Android native build refuses: it wants one for every assembly it is given. Nothing
      in a published head needs it.
    -->
    <UnoDisableHotDesign>true</UnoDisableHotDesign>
  </PropertyGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('-android')) And '$(SundewAndroidAot)' == 'true'">
    <!--
      Android compiles ahead of time with the trimmer set to full, which strips System.Dynamic out of
      System.Linq.Expressions. Something below still asks for DynamicMetaObject, and the native compiler then
      fails to load a type that is no longer there, so the assembly is kept whole.
    -->
    <TrimmerRootAssembly Include="System.Linq.Expressions" RootMode="All" />
  </ItemGroup>


</Project>
