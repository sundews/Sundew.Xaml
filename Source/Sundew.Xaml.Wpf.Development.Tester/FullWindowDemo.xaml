<sx:FullWindow x:Class="Sundew.Xaml.Wpf.Development.Tester.FullWindowDemo"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                     xmlns:sx="clr-namespace:Sundew.Xaml.Controls;assembly=Sundew.Xaml.Controls.Wpf"
                     Title="Full window" Width="620" Height="480"
                     Backdrop="Mica" CaptionHeight="40">
    <sx:FullWindow.Resources>
        <!--
          A caption button of one's own, which is the whole point of a window with no non client area. It has to
          say IsHitTestVisibleInChrome, or the caption the window manager was handed takes the click first and
          the button never hears about it.
        -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Hover" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="#20000000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </sx:FullWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!--
          What the window puts between the backdrop and the content, for seeing how much of one the other lets
          through. It is the first child, so everything else is drawn over it.
        -->
        <Border x:Name="Tint" Grid.RowSpan="2" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" Opacity="0"/>

        <!-- The caption, drawn as content like everything else. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Full window" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize"
                        Command="{Binding MinimizeCommand, RelativeSource={RelativeSource AncestorType=sx:FullWindow}}"/>
                <Button Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximize"
                        Command="{Binding MaximizeCommand, RelativeSource={RelativeSource AncestorType=sx:FullWindow}}"/>
                <Button Style="{StaticResource CaptionButton}" Content="&#xE923;" ToolTip="Restore"
                        Command="{Binding RestoreCommand, RelativeSource={RelativeSource AncestorType=sx:FullWindow}}"/>
                <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" ToolTip="Close"
                        Command="{Binding CloseCommand, RelativeSource={RelativeSource AncestorType=sx:FullWindow}}"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="16,8,16,16">
            <TextBlock TextWrapping="Wrap"
                       Text="Nothing above this is the system's. The strip is content, handed back to the window manager as the caption, so dragging it moves the window, double clicking it maximizes and restores it, and right clicking it opens the system menu."/>
            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="The four buttons are bound to the window's own commands. Maximize and restore disable themselves, each knowing the window is already the way it would put it."/>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <TextBlock Text="Backdrop" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="BackdropSelector" Width="120"/>
                <TextBlock x:Name="BackdropLabel" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.7"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Tint" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Slider x:Name="TintSlider" Width="140" Minimum="0" Maximum="1" Value="0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TintLabel" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.7"/>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" Opacity="0.7"
                       Text="Put another window in front of this one and the backdrop goes flat: the window manager draws one only for the window in front. A WinUI window can say otherwise, by running the backdrop itself; this one cannot."/>
        </StackPanel>
    </Grid>
</sx:FullWindow>
