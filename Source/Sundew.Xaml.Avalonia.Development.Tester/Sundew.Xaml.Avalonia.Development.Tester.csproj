<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      The desktop, Android, iOS and browser heads of one tester. The last three need the android, ios and
      wasm-tools workloads, which a plain build agent does not have, so CI sets SundewAvaloniaAllHeads=false
      and builds the desktop head alone.
    -->
    <SundewAvaloniaAllHeads Condition="'$(SundewAvaloniaAllHeads)' == ''">true</SundewAvaloniaAllHeads>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(SundewAvaloniaAllHeads)' == 'true'">net10.0;net10.0-android;net10.0-ios;net10.0-browser</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sundew.Xaml.Avalonia.Development.Tester</RootNamespace>
    <IsPackable>false</IsPackable>
    <!--
      The Android head makes ApplicationDisplayVersion the $(Version), and so the $(PackageVersion), of that
      head alone. NuGet requires one PackageVersion across every head of a project and fails restore with
      NU1105 otherwise, so it is pinned to the repository version that both heads start from.
    -->
    <PackageVersion>$(Version)</PackageVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <OutputType>WinExe</OutputType>
    <!-- NativeAOT, which this head supports and the Android, iOS and browser heads do not. It is set here rather
         than passed on the command line: a command line property reaches every referenced project, and the
         netstandard2.0 primitives library cannot be compiled ahead of time at all. -->
    <PublishAot>true</PublishAot>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('-android'))">
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <ApplicationId>dev.sundew.xaml.avaloniatester</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AndroidManifest>Properties\AndroidManifest.xml</AndroidManifest>
    <!-- The Android build runs an intermediate compile without a PDB, which source embedding forbids. -->
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
  </PropertyGroup>

  <!--
    NativeAOT for Android, which .NET 10 supports through a runtime pack of its own. It is deliberately not on by
    default: with PublishAot set, an ordinary build runs the trimmer and the native compiler too, because an
    Android app carries its code as a native library inside the apk. That turns every solution build into an AOT
    build. The launcher asks for it when it publishes a head to a device.
  -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-android')) And '$(SundewAndroidAot)' == 'true'">
    <PublishAot>true</PublishAot>
    <!-- Mono.Android and Java.Interop report AOT analysis warnings of their own, which are not ours to fix. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('-ios'))">
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <!-- Platforms\iOS\Info.plist carries the bundle identifier and versions rather than MSBuild properties. -->
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('-browser'))">
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <WasmMainJSPath>wwwroot\main.js</WasmMainJSPath>
    <!-- WasmAppHost, which dotnet run and F5 start, refuses to serve without a perHostConfig. -->
    <UserRuntimeConfig>Platforms\Browser\runtimeconfig.template.json</UserRuntimeConfig>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sundew.Xaml.Controls.Avalonia\Sundew.Xaml.Controls.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <!-- Each head brings its own windowing and its own entry point. -->
  <ItemGroup>
    <Compile Remove="Platforms\**\*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
    <Compile Remove="Program.cs" />
    <Compile Include="Platforms\Android\**\*.cs" />
    <!-- Linked so that the folder they are kept in does not become part of the resource path. -->
    <AndroidResource Include="Platforms\Android\Resources\**\*" Link="Resources\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidResource Include="Platforms\Android\Icon.png" Link="Resources\drawable\Icon.png" />
    <EmbeddedFiles Remove="@(EmbeddedFiles)" />
    <PackageReference Include="Avalonia.Android" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('-ios'))">
    <Compile Remove="Program.cs" />
    <Compile Include="Platforms\iOS\**\*.cs" />
    <None Include="Platforms\iOS\Info.plist" LogicalName="Info.plist" />
    <EmbeddedFiles Remove="@(EmbeddedFiles)" />
    <PackageReference Include="Avalonia.iOS" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('-browser'))">
    <Compile Remove="Program.cs" />
    <Compile Include="Platforms\Browser\**\*.cs" />
    <!-- main.js is deployed by WasmMainJSPath; the page that hosts it is not. -->
    <WasmExtraFilesToDeploy Include="wwwroot\index.html" />
    <PackageReference Include="Avalonia.Browser" />
  </ItemGroup>

  <ItemGroup>
    <!-- The startup clock, shared so that every tester measures the same span the same way. -->
    <Compile Include="..\Shared\Development\StartupClock.cs" LinkBase="Shared\Development" />
  </ItemGroup>

</Project>
