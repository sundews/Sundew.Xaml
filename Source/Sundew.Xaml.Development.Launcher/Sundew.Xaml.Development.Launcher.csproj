<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Sundew.Xaml.Development.Launcher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <Description>Launches the development testers side by side, so that the border can be compared across platforms.</Description>
    <!-- The WinUI markup compiler runs an intermediate compile without a PDB, which the source
         embedding the repository turns on globally is not allowed alongside. -->
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedFiles Remove="@(EmbeddedFiles)" />
  </ItemGroup>

  <!--
    This deliberately references none of the testers. It starts them through the dotnet CLI instead, so that it
    builds and runs on an agent that has none of the android, iOS or wasm workloads they need.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

</Project>
