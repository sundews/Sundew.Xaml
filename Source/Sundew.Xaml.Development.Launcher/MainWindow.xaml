<Window x:Class="Sundew.Xaml.Development.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Sundew.Xaml.Development.Launcher">
  <Grid Padding="16" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- The emulator chosen here is the one a tester uses unless it names another, and the one more instances are
         started from when several Android testers run at once. -->
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <TextBlock Text="Default emulator" VerticalAlignment="Center"/>
      <ComboBox x:Name="VirtualDeviceBox" MinWidth="240"/>
      <Button Content="Refresh" Click="OnRefresh"/>
      <TextBlock x:Name="DeviceSummary" VerticalAlignment="Center" Opacity="0.7" Margin="12,0,0,0"/>
      <CheckBox x:Name="BuildFirstBox" Content="Build solution first" Margin="12,0,0,0" IsChecked="False"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
      <Button Content="Launch all" Click="OnLaunchAll" Style="{StaticResource AccentButtonStyle}"/>
      <Button Content="Windows" Click="OnLaunchWindows"/>
      <Button Content="Android" Click="OnLaunchAndroid"/>
      <Button Content="Browser" Click="OnLaunchBrowser"/>
      <Button Content="Stop all" Click="OnStopAll"/>
      <Button Content="Tile windows" Click="OnTile"/>
    </StackPanel>

    <ListView Grid.Row="2" x:Name="TesterList" SelectionMode="None"
              ScrollViewer.HorizontalScrollMode="Disabled">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="local:TesterItem">
          <Grid ColumnSpacing="12" Padding="0,6" MinHeight="48">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="170"/>
              <ColumnDefinition Width="230"/>
              <ColumnDefinition Width="200"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="{x:Bind TargetFramework}" VerticalAlignment="Center" Opacity="0.7"/>
            <ComboBox Grid.Column="2" MinWidth="190" VerticalAlignment="Center"
                      Visibility="{x:Bind AndroidVisibility}"
                      ItemsSource="{x:Bind VirtualDevices, Mode=OneWay}"
                      SelectedItem="{x:Bind VirtualDevice, Mode=TwoWay}"/>
            <TextBlock Grid.Column="3" Text="{x:Bind Status, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Button Content="Launch" Click="OnLaunch" IsEnabled="{x:Bind CanLaunch, Mode=OneWay}"/>
              <Button Content="Stop" Click="OnStop" IsEnabled="{x:Bind IsRunning, Mode=OneWay}"/>
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <ScrollViewer Grid.Row="3" Height="200" x:Name="LogScroller">
      <TextBlock x:Name="LogBox" FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="NoWrap"/>
    </ScrollViewer>
  </Grid>
</Window>
