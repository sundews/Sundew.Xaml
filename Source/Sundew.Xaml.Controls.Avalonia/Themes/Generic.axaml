<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:overlays="using:Sundew.Xaml.Controls.Overlays"
                    xmlns:sx="using:Sundew.Xaml.Controls">

  <overlays:StringNotNullOrEmptyToBooleanConverter x:Key="StringNotNullOrEmptyToBooleanConverter"/>

  <!-- Transparent at the middle and opaque at the rim, so that as an opacity mask it leaves a hole where the
       cursor is. The radius is in device independent pixels, which Avalonia takes a plain number to mean. -->
  <RadialGradientBrush x:Key="RevealBrush" RadiusX="50" RadiusY="50">
    <GradientStop Color="Transparent" Offset="0"/>
    <GradientStop Color="Transparent" Offset="0.96"/>
    <GradientStop Color="Black" Offset="1"/>
  </RadialGradientBrush>

  <ControlTheme x:Key="{x:Type overlays:SubtitleOverlay}" TargetType="overlays:SubtitleOverlay">
    <Setter Property="Background" Value="#990C0A0A"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Padding" Value="16,8"/>
    <Setter Property="FontSize" Value="32"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="MaxWidth" Value="{Binding $self.MonitorWidth}"/>
    <Setter Property="MaxHeight" Value="{Binding $self.MonitorHeight}"/>
    <Setter Property="RevealBrush" Value="{StaticResource RevealBrush}"/>
    <Setter Property="Template">
      <ControlTemplate TargetType="overlays:SubtitleOverlay">
        <Panel>
          <!-- What a top level paints with when the window manager cannot give it a transparent window. It is
               found by name, so it is here even though an overlay has nothing else to say about it. -->
          <Border Name="PART_TransparencyFallback" IsHitTestVisible="False"/>
          <VisualLayerManager>
            <Grid RowDefinitions="*,0.04*"
                  IsVisible="{TemplateBinding Subtitle, Converter={StaticResource StringNotNullOrEmptyToBooleanConverter}}">
              <!-- Laid out at the size the subtitle wants, which is what the visible border eases toward. It is
                   drawn at no opacity rather than hidden, because a hidden visual is not laid out at all and so
                   would have no size to read. -->
              <sx:Border Name="PART_MeasureBorder" Grid.Row="0"
                         HorizontalAlignment="Center" VerticalAlignment="Bottom"
                         CornerRadius="{TemplateBinding CornerRadius}"
                         Padding="{TemplateBinding Padding}"
                         Opacity="0"
                         IsHitTestVisible="False"
                         MaxWidth="{TemplateBinding MaxWidth}"
                         MaxHeight="{TemplateBinding MaxHeight}">
                <TextBlock Name="MeasureTextBlock"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="{TemplateBinding Subtitle}"
                           Foreground="{TemplateBinding Foreground}"
                           FontSize="{TemplateBinding FontSize}"
                           FontWeight="{TemplateBinding FontWeight}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
              </sx:Border>
              <sx:Border Name="PART_Border" Grid.Row="0"
                         Background="{TemplateBinding Background}"
                         HorizontalAlignment="Center" VerticalAlignment="Bottom"
                         CornerRadius="{TemplateBinding CornerRadius}"
                         Padding="{TemplateBinding Padding}"
                         ClipContentToCornerRadius="True"
                         MaxWidth="{TemplateBinding MaxWidth}"
                         MaxHeight="{TemplateBinding MaxHeight}">
                <sx:Border.Effect>
                  <DropShadowEffect BlurRadius="15" OffsetX="3" OffsetY="3" Color="Black" Opacity="0.4"/>
                </sx:Border.Effect>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           Width="{Binding #MeasureTextBlock.Bounds.Width}"
                           Text="{TemplateBinding Subtitle}"
                           Foreground="{TemplateBinding Foreground}"
                           FontSize="{TemplateBinding FontSize}"
                           FontWeight="{TemplateBinding FontWeight}"
                           TextWrapping="Wrap"
                           TextAlignment="Center">
                  <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="3" OffsetX="1" OffsetY="1" Color="Black" Opacity="0.8"/>
                  </TextBlock.Effect>
                </TextBlock>
              </sx:Border>
            </Grid>
          </VisualLayerManager>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
