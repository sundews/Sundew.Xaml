<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sundew.Xaml.Controls</RootNamespace>
    <Description>Various Avalonia controls:
- Border - A border supporting individual brushes for each side.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sundew.Xaml.Controls.Primitives\Sundew.Xaml.Controls.Primitives.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <!--
    Stops and CornerStops are the XAML surface rather than geometry, so each platform library compiles its own copy
    from one source. Sharing them as an assembly instead would put the same type name in two assemblies of the same
    reference graph, which the WinUI and Uno XAML compilers cannot resolve.
  -->
  <ItemGroup>
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>

</Project>
