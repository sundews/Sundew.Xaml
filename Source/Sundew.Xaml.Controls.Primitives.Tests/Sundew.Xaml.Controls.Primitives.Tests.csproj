<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sundew.Xaml.Controls.Primitives.Tests</RootNamespace>
    <!--
      The shared renderer documents itself in terms of the Border control that hosts it, and there is no Border
      here. Only the unresolved cref is excused, so a real documentation mistake is still an error everywhere.
    -->
    <NoWarn>$(NoWarn);CS1574</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sundew.Xaml.Controls.Primitives\Sundew.Xaml.Controls.Primitives.csproj" />
  </ItemGroup>

  <!--
    Stops and CornerStops are the XAML surface rather than geometry, so each platform library compiles its own copy
    from one source. Sharing them as an assembly instead would put the same type name in two assemblies of the same
    reference graph, which the WinUI and Uno XAML compilers cannot resolve.
  -->
  <ItemGroup>
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <!--
    The shared renderer, which every backend compiles its own copy of and so none of them owns the tests for.
    It reaches a backend only through IBorderDrawingSession, so it needs no graphics library to be tested.
  -->
  <ItemGroup>
    <Compile Include="..\Shared\Rendering\*.cs" LinkBase="Shared\Rendering" />
  </ItemGroup>

</Project>
